   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roundness": null,
   "text": "Start groups only while fewer than\ngroups_per_step are live. Collect them,\ntrain, publish, then start the next set.\nEvery sample in a batch comes from the\npolicy that batch trains.",
   "originalText": "Start groups only while fewer than\ngroups_per_step are live. Collect them,\ntrain, publish, then start the next set.\nEvery sample in a batch comes from the\npolicy that batch trains.",
