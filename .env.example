# Copy to .env next to your training config (or in the directory you run from).
# `loops` loads it before importing any SDK. Variables already
# exported in your shell take precedence. Never commit .env.

# --- Baseten Loops (required) -------------------------------------------------
# API key for a Baseten workspace with Loops enabled. Used to provision the LoRA
# trainer and sampler and to sample from the policy.
BASETEN_API_KEY=

# --- Blaxel sandboxes (optional; only for a run with [providers.blaxel])
# Install the extra first: uv sync --extra blaxel, or --extra harbor-blaxel for a Harbor
# job. Docker jobs need no credentials.
# BL_WORKSPACE=
# BL_API_KEY=

# --- Daytona sandboxes (optional; only for a run with [providers.daytona])
# Install the extra first: uv sync --extra daytona, or --extra harbor-daytona for a
# Harbor job. DAYTONA_API_URL only for a self-hosted Daytona.
# DAYTONA_API_KEY=
# DAYTONA_API_URL=

# --- Hugging Face (optional) --------------------------------------------------
# Needed to download tokenizers for gated or private models (e.g. an early-access
# repo named by `[model] tokenizer`). The renderer loads the tokenizer
# from `[model] tokenizer`, default `base_model`, during `check` and `run`.
# HF_TOKEN=

# --- Weights & Biases (optional; only with `wandb_project` in the training TOML)
# Install the extra first: uv sync --extra wandb
# WANDB_API_KEY=
# WANDB_ENTITY=
